//  - Final Range Boost
#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>
#include <Servo.h>

Servo ch1, ch2, ch3, ch4, ch5, ch6;

struct Signal {
  byte throttle;
  byte yaw;
  byte pitch;
  byte roll;
  byte aux1;
  byte aux2;
};

Signal data;
const uint64_t pipeIn = 0xE9E8F0F0E1LL;
RF24 radio(7, 8);

unsigned long lastRecvTime = 0;

void ResetData() {
  data.roll = 127; data.pitch = 127; data.throttle = 12;
  data.yaw = 127; data.aux1 = 0; data.aux2 = 127;
}

void setup() {
  Serial.begin(250000);
  pinMode(13, OUTPUT);
  
  if (!radio.begin()) {
    while (1) { Serial.println("NRF Error!"); delay(1000); }
  }

  // --- RANGE SETTINGS (Must match TX) ---
  radio.setChannel(115);
  radio.setDataRate(RF24_250KBPS); 
  radio.setPALevel(RF24_PA_MAX);
  radio.setCRCLength(RF24_CRC_8);
  radio.setAutoAck(false);
  // --------------------------------------

  radio.openReadingPipe(1, pipeIn);
  radio.startListening();
  
  ResetData();
  
  ch1.attach(9); ch2.attach(2); ch3.attach(3);
  ch4.attach(4); ch5.attach(5); ch6.attach(6);

  Serial.println("Receiver Ready - Waiting at 250KBPS...");
}

void loop() {
  if (radio.available()) {
    radio.read(&data, sizeof(Signal));
    lastRecvTime = millis();
    digitalWrite(13, HIGH); // Signal OK
  }

  if (millis() - lastRecvTime > 1000) {
    digitalWrite(13, LOW); // Signal Lost
    ResetData();
  }

  ch1.writeMicroseconds(map(data.roll, 0, 255, 1000, 2000));
  ch2.writeMicroseconds(map(data.pitch, 0, 255, 1000, 2000));
  ch3.writeMicroseconds(map(data.throttle, 0, 255, 1000, 2000));
  ch4.writeMicroseconds(map(data.yaw, 0, 255, 1000, 2000));
  ch5.writeMicroseconds(data.aux1 == 0 ? 1000 : 2000);
  ch6.writeMicroseconds(map(data.aux2, 0, 255, 1000, 2000));
}
